# Endereço opcional da API. Sem esta variável, o frontend usa o proxy /backend.
# NEXT_PUBLIC_API_URL=https://api.exemplo.com

# Destino usado pelo proxy interno /backend. Para desenvolvimento com a API local:
API_PROXY_TARGET=http://localhost:8080/api

# Acesso de contingência para ambientes de demonstração sem API.
# Em produção, só habilite temporariamente e faça um novo deploy.
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
NEXT_PUBLIC_MOCK_AUTH_USERNAME=admin.mock
NEXT_PUBLIC_MOCK_AUTH_PASSWORD=Mock@123456789!
